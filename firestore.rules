rules_version = '2';

// Who can do what:
//  - Anyone can CREATE a booking request (customers do not need an account),
//    but only with the exact fields and sizes below.
//  - Only the studio owner (signed in with the Google account below) can READ,
//    change the STATUS of, or DELETE bookings.
//  - Everything else is blocked.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'blushwithmokshamakeupstudio@gmail.com';
    }

    function optStr(d, f, max) {
      return !(f in d) || (d[f] is string && d[f].size() <= max);
    }

    function validBooking(d) {
      return d.keys().hasOnly(['name', 'phone', 'service', 'date', 'timeOfDay', 'people', 'mode', 'address', 'city', 'notes', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'phone', 'service', 'date', 'timeOfDay', 'people', 'mode', 'status', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 20
        && d.service is string && d.service.size() > 0 && d.service.size() <= 60
        && d.date is string && d.date.size() == 10
        && d.timeOfDay is string && d.timeOfDay.size() <= 20
        && d.people is int && d.people >= 1 && d.people <= 20
        && d.mode in ['studio', 'travel']
        && d.status == 'new'
        && d.createdAt == request.time
        && optStr(d, 'address', 200)
        && optStr(d, 'city', 80)
        && optStr(d, 'notes', 500);
    }

    match /bookings/{bookingId} {
      allow create: if validBooking(request.resource.data);
      allow read, delete: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'confirmed', 'done', 'cancelled'];
    }
  }
}
